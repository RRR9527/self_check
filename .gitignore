# ===== IDE / Editor =====
.vscode/
.idea/
*.code-workspace

# ===== STM32CubeMX =====
# .mxproject is regenerated by CubeMX whenever the .ioc is opened/saved
.mxproject

# ===== Keil MDK-ARM / uVision =====
# User-specific options and window layout (regenerated by the IDE)
MDK-ARM/*.uvoptx
MDK-ARM/*.uvguix.*
MDK-ARM/*.uvgui.*
MDK-ARM/EventRecorderStub.scvd

# Runtime Environment headers (auto-generated from CMSIS packs)
MDK-ARM/RTE/

# Debugger configuration (auto-generated)
MDK-ARM/DebugConfig/

# Build output (objects, binary, map, listings)
MDK-ARM/self_check/
MDK-ARM/Listing/

# ===== Compiled objects & binaries =====
*.o
*.d
*.crf
*.dep
*.lst
*.map
*.axf
*.elf
*.hex
*.bin
*.htm
*.lnp
*.iex
*.scvd
*.bak

# ===== OS / misc =====
Thumbs.db
.DS_Store
*.log
*.tmp
